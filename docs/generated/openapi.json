                    "format": "uuid",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_-]+$",
              "type": "string"
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true
          }
        ],
        "security": [
