{
  "name": "besu-operations-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.22.1", "npm": "11.19.1" },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsx scripts/build.ts && npm run contract:compile && npm run openapi",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/integration/database.test.ts",
    "test:ui": "playwright test",
    "check": "npm run pins:check && npm run lint && npm run typecheck && npm test && npm run build",
    "pins:check": "tsx scripts/check-pins.ts",
    "compose:generate": "tsx scripts/render-compose.ts",
    "openapi": "tsx scripts/openapi.ts",
    "contract:compile": "tsx scripts/compile-contract.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "api": "tsx apps/api/main.ts",
    "worker": "tsx apps/worker/main.ts",
    "lab:init": "tsx scripts/lab.ts init",
    "lab:up": "tsx scripts/lab.ts up",
    "lab:down": "tsx scripts/lab.ts down",
    "lab:verify": "tsx tests/integration/lab.ts",
    "lab:credentials": "tsx scripts/lab.ts credentials"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@fastify/swagger": "9.9.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "oidc-client-ts": "3.5.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "solc": "0.8.38",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": { "solc": { "tmp": "0.2.7" } }
}
